# ---------------------------------------------------------------------------
# ReviewTap — environment variables
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local or real secrets to git.
# ---------------------------------------------------------------------------

# App
# Public base URL of this deployment. Used to build the permanent
# https://<domain>/r/<deviceId> links written to NFC chips and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-side only, NEVER exposed to the browser.
# Used by Stripe webhooks and the /r/[deviceId] redirect route.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring €20/month "ReviewTap Pro" price ID (price_...)
# Pro: visitors get a chooser page to pick their platform (Google/Facebook/
# Trustpilot/Tripadvisor) and can share that page.
STRIPE_PRICE_ID=
# Recurring €10/month "ReviewTap Basic" price ID (price_...)
# Basic: a single fixed destination, direct redirect.
# Not in the original minimal env list, but required for the two-tier plan.
STRIPE_PRICE_ID_BASIC=
# One-time €50 "ReviewTap NFC" device price ID (price_...)
# Not in the original minimal env list, but required: Checkout runs in
# "subscription" mode with this one-time price added as an extra line item
# when the app is bundled, or in plain "payment" mode when the device is
# bought on its own.
STRIPE_PRICE_ID_ONE_TIME=
